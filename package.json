{
  "name": "gta6-countdown",
  "private": true,
  "version": "1.0.0",
  "description": "macOS desktop and menu bar widget counting down to Grand Theft Auto VI",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "widget:dev": "tauri dev",
    "widget:build": "tauri build",
    "widget:dist": "tauri build && bash packaging/make-dist.sh"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2"
  },
  "devDependencies": {
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "typescript": "~5.8.3",
    "vite": "^7.0.4",
    "@tauri-apps/cli": "^2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
